# ── Base de datos (Neon / PostgreSQL) ─────────────────────────────
# Usa la cadena de conexión "pooled" de Neon (la que incluye "-pooler").
# Debe terminar en ?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Seguridad de sesión ───────────────────────────────────────────
# Cadena aleatoria y secreta para firmar el token de sesión.
# Genera una con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
