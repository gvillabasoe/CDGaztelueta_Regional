// CD Gaztelueta — esquema de datos
// Modela ÚNICAMENTE los datos descritos en el prompt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  PLAYER
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum CardType {
  YELLOW
  RED
}

enum ActivityType {
  TRAINING
  MATCH
}

enum AttendanceStatus {
  GOING // SÍ, ASISTIRÉ
  NOT_GOING // NO ASISTIRÉ
}

enum AbsenceReason {
  LESION
  ENFERMEDAD
  TRABAJO
  ESTUDIOS
  VIAJE
  FAMILIAR
  OTRO
}

enum PollStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum ProposalStatus {
  PENDIENTE
  EN_REVISION
  ACEPTADA
  RECHAZADA
}

// ── Usuarios y acceso ─────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // hash bcrypt
  role          Role
  player        Player?
  createdAt     DateTime @default(now())
  hideStandings Boolean  @default(false) // preferencia personal: ocultar clasificación oficial en HOME
}

// ── Ficha del jugador (7) ─────────────────────────────────────────
model Player {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  nickname  String?
  number    Int?
  age       Int?
  isCaptain Boolean  @default(false)
  positions String[]
  photo     String? // data URL
  email     String? // correo normalizado (vinculación cuenta<->ficha)
  phone     String? // teléfono (opcional)
  status    PlayerStatus @default(ACTIVE) // activo / inactivo / pendiente de revisión
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  // Estadísticas deportivas (manuales, 7.2)
  callups     Int @default(0) // convocatorias
  minutes     Int @default(0) // minutos jugados
  starts      Int @default(0) // titularidades
  benchCount  Int @default(0) // suplencias
  goalsCount  Int @default(0) // goles marcados
  leaguePoints Int @default(0) // liga interna (6)

  attendance      Attendance[]
  exerciseRatings ExerciseRating[]
  calledFor       Activity[]       @relation("Callup")
  fines           Fine[]
  proposals       Proposal[]
  trainingEntries TrainingPlayer[]
  matchEntries    MatchPlayer[]
  goals           MatchGoal[]
  cards           MatchCard[]
  subsIn          Substitution[]   @relation("SubIn")
  subsOut         Substitution[]   @relation("SubOut")
  pollCandidacies Poll[]           @relation("PollCandidates")
}

// ── Datos generales del club (1) ──────────────────────────────────
model TeamProfile {
  id        Int      @id @default(1) // fila única
  name      String   @default("CD Gaztelueta")
  info      String? // información general
  crestData Bytes? // escudo personalizado (si no, se usa /escudo.jpg)
  crestMime String?
  photoData Bytes? // fotografía de la plantilla
  photoMime String?
  updatedAt DateTime @updatedAt
}

// ── Próximo partido de liga (5.1) ─────────────────────────────────
model NextMatch {
  id        Int       @id @default(1) // fila única
  matchday  Int?
  date      DateTime?
  time      String?
  opponent  String?
  place     String?
  isHome    Boolean   @default(true)
  updatedAt DateTime  @updatedAt
}

// ── Clasificación oficial (5.2), editable por el entrenador ───────
model OfficialStanding {
  id            String   @id @default(cuid())
  teamName      String
  played        Int      @default(0)
  won           Int      @default(0)
  drawn         Int      @default(0)
  lost          Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  points        Int      @default(0)
  createdAt     DateTime @default(now())
}

// ── Planificación semanal (8) ─────────────────────────────────────
model WeeklyPlan {
  id        String     @id @default(cuid())
  weekStart DateTime   @unique
  published Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  activities Activity[]
}

// Actividad de la semana: entrenamiento o partido (8.2 / 8.3)
model Activity {
  id         String       @id @default(cuid())
  planId     String
  type       ActivityType
  date       DateTime // fecha completa
  startTime  String // hora de inicio "HH:MM"
  endTime    String? // hora de finalización (opcional)
  place      String? // campo o lugar
  // Solo partido:
  opponent   String?
  matchday   Int?
  callTime   String? // hora de convocatoria
  kitLocal   Boolean? // equipación: true=Local, false=Visitante
  // Documento del entrenamiento (8.4.1):
  fileData   Bytes?
  fileName   String?
  fileMime   String?
  orderIndex Int          @default(0)
  createdAt  DateTime     @default(now())

  plan          WeeklyPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  attendance    Attendance[]
  calledPlayers Player[]        @relation("Callup") // convocatoria (máx. 18)
  trainingRecord TrainingRecord?
  matchRecord    MatchRecord?
  poll           Poll?
}

// Ejercicio de un entrenamiento (8.4.2)
model Exercise {
  id          String           @id @default(cuid())
  activityId  String
  task        String // imprescindible
  description String?
  objective   String?
  duration    String?
  orderIndex  Int              @default(0)
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ratings     ExerciseRating[]
}

// Valoración de un ejercicio por un jugador (8.8)
model ExerciseRating {
  id         String   @id @default(cuid())
  exerciseId String
  playerId   String
  rating     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, playerId])
}

// Confirmación de asistencia por actividad (8.5).
// Si no existe fila para un jugador, se considera GOING (verde) por defecto.
model Attendance {
  id          String           @id @default(cuid())
  activityId  String
  playerId    String
  status      AttendanceStatus @default(GOING)
  reason      AbsenceReason?
  explanation   String?
  updatedAt     DateTime         @updatedAt
  modifiedById  String? // usuario que hizo el último cambio (auditoría)
  modifiedByName String?
  modifiedAt    DateTime?
  outOfTime     Boolean          @default(false) // cambio realizado fuera de plazo (solo entrenador)
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  player      Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([activityId, playerId])
}

// ── Registro posterior de entrenamiento (8.6) ─────────────────────
model TrainingRecord {
  id         String           @id @default(cuid())
  activityId String           @unique
  date       DateTime
  createdAt  DateTime         @default(now())
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  players    TrainingPlayer[]
}

model TrainingPlayer {
  id            String         @id @default(cuid())
  recordId      String
  playerId      String
  attended      Boolean        @default(true)
  justified     Boolean?
  absenceReason String?
  grade         Float?
  observations  String?
  record        TrainingRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  player        Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([recordId, playerId])
}

// ── Registro posterior de partido (8.7) ───────────────────────────
model MatchRecord {
  id                  String         @id @default(cuid())
  activityId          String         @unique
  date                DateTime
  opponent            String?
  formation           String?
  teamGoals           Int            @default(0)
  opponentGoals       Int            @default(0)
  globalGrade         Float?
  generalObservations String?
  createdAt           DateTime       @default(now())
  activity            Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  players             MatchPlayer[]
  goals               MatchGoal[]
  substitutions       Substitution[]
  cards               MatchCard[]
}

model MatchPlayer {
  id           String      @id @default(cuid())
  recordId     String
  playerId     String
  isStarter    Boolean     @default(false)
  position     String?
  grade        Float?
  observations String?
  record       MatchRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([recordId, playerId])
}

model MatchGoal {
  id       String      @id @default(cuid())
  recordId String
  playerId String
  minute   Int?
  record   MatchRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  player   Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Substitution {
  id          String      @id @default(cuid())
  recordId    String
  playerOutId String
  playerInId  String
  minute      Int?
  record      MatchRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  playerOut   Player      @relation("SubOut", fields: [playerOutId], references: [id], onDelete: Cascade)
  playerIn    Player      @relation("SubIn", fields: [playerInId], references: [id], onDelete: Cascade)
}

model MatchCard {
  id       String      @id @default(cuid())
  recordId String
  playerId String
  type     CardType
  record   MatchRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  player   Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ── Multas (10). Una multa por jugador; fuente central. ───────────
model Fine {
  id        String   @id @default(cuid())
  playerId  String
  date      DateTime // fecha de la infracción
  concept   String // concepto o motivo
  amount     Float // importe
  paid       Boolean  @default(false) // pagado por completo (derivado de amountPaid)
  amountPaid Float    @default(0) // cantidad abonada (permite pagos parciales)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// ── Propuestas (9) ────────────────────────────────────────────────
model Proposal {
  id        String         @id @default(cuid())
  playerId  String
  title     String
  message   String
  response  String?
  status    ProposalStatus @default(PENDIENTE)
  createdAt DateTime       @default(now())
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

// Votación de "Jugador del Mes" (13-20). Vinculada a un partido (Activity MATCH).
model Poll {
  id           String     @id @default(cuid())
  activityId   String     @unique
  activity     Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  monthKey     String // "YYYY-MM": mes al que se asignan los puntos (fecha del partido)
  closesAt     DateTime // cierre (por defecto martes 23:59 Europe/Madrid)
  status       PollStatus @default(OPEN)
  allowSelfVote Boolean   @default(false)
  createdAt    DateTime   @default(now())

  candidates Player[]  @relation("PollCandidates")
  ballots    Ballot[]
}

// Papeleta 3-2-1 (16-17). Anónima frente a los jugadores.
// voterId = id del User que vota. first/second/third = ids de Player (3/2/1 puntos).
model Ballot {
  id        String   @id @default(cuid())
  pollId    String
  voterId   String
  firstId   String // 3 puntos
  secondId  String // 2 puntos
  thirdId   String // 1 punto
  excluded  Boolean  @default(false)
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterId])
}
